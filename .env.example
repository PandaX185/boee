# Copy to `.env` for local development. Never commit `.env`.
#
# IMPORTANT: only `EXPO_PUBLIC_*` variables are visible to the app, and they are
# inlined into the JavaScript bundle. They are NOT secret. Never put API keys,
# tokens, or credentials here — see docs/secrets.md.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the (future) backend/proxy. Leave unset for local-only usage.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
